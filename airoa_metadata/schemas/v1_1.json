{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metadata version 1.1",
  "description": "Schema describing versioned run metadata, including files, context, data schema reference, and run details.",
  "type": "object",
  "required": ["uuid", "version", "files", "context", "run"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Schema declaration (ignored by validator during instance validation)."
    },
    "$id": {
      "type": "string",
      "format": "uri",
      "description": "Schema identifier (ignored by validator during instance validation)."
    },
    "$data_config": {
      "type": "object",
      "format": "uri",
      "description": "Robot Data Config declaration (ignored by validator during instance validation)."
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this run."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version in major.minor format (e.g. \"1.1\")."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "List of input files associated with this run.",
      "items": { "$ref": "#/definitions/file" }
    },
    "context": {
      "type": "object",
      "description": "Contextual information: entities involved and software components used.",
      "required": ["entities", "components"],
      "properties": {
        "entities": {
          "type": "array",
          "description": "Actors or locations referenced in this run.",
          "items": { "$ref": "#/definitions/entity" }
        },
        "components": {
          "type": "array",
          "description": "Software/hardware components and their source versions.",
          "items": { "$ref": "#/definitions/component" }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "description": "Execution details for this run: timing, instructions, and segments.",
      "required": ["total_time_s", "instructions", "segments"],
      "properties": {
        "total_time_s": {
          "type": "number",
          "minimum": 0,
          "description": "Total duration of the run in seconds (rosbag time)."
        },
        "instructions": {
          "type": "array",
          "description": "Ordered list of high-level instructions executed.",
          "items": { "$ref": "#/definitions/instruction" }
        },
        "segments": {
          "type": "array",
          "description": "Time-segmented execution records corresponding to instructions.",
          "items": { "$ref": "#/definitions/segment" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "file": {
      "type": "object",
      "description": "An input file, such as a rosbag or log.",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Kind of file (e.g. 'rosbag', 'rosbag2')."
        },
        "name": {
          "type": "string",
          "description": "File path from location of metadata file location."
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "description": "An actor, location, organization, or task template in context.",
      "required": ["role"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["robot", "operator", "location", "organization", "task"],
          "description": "Role of this entity in the context."
        },
        "id": {
          "type": "string",
          "description": "Identifier (required for robot, operator, and task)."
        },
        "name": {
          "type": "string",
          "description": "Name (required for location, organization)."
        },
        "template": {
          "type": "object",
          "description": "Task template details (only for role='task').",
          "required": ["name", "description"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Template name."
            },
            "description": {
              "type": "string",
              "description": "Template description."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "task" } }
          },
          "then": {
            "required": ["id", "template"]
          }
        },
        {
          "if": {
            "properties": { "role": { "enum": ["robot", "operator", "location", "organization"] } }
          },
          "then": {
            "oneOf": [
              { "required": ["id"] },
              { "required": ["name"] }
            ]
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "description": "A software or hardware component used in the data collection and its source version.",
      "required": ["role", "name", "source"],
      "properties": {
        "role": {
          "type": "string",
          "description": "Component role (e.g. interface, data_collection)."
        },
        "name": {
          "type": "string",
          "description": "Component name."
        },
        "source": {
          "type": "object",
          "description": "Source control metadata.",
          "required": ["git"],
          "properties": {
            "git": {
              "type": "object",
              "description": "Git repository snapshot used for this component.",
              "required": ["uri", "hash", "branch"],
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri",
                  "description": "Git repository URI."
                },
                "hash": {
                  "type": "string",
                  "description": "Commit hash."
                },
                "branch": {
                  "type": "string",
                  "description": "Branch name."
                },
                "tag": {
                  "type": "string",
                  "description": "Optional Git tag."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "instruction": {
      "type": "object",
      "description": "A high-level instruction step.",
      "required": ["idx", "text"],
      "properties": {
        "idx": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based instruction index."
        },
        "text": {
          "type": "array",
          "items": { "type": "string" },
          "description": "One or more textual variants of this instruction."
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "description": "Timing and outcome of a single instruction execution segment.",
      "required": ["start_time", "end_time", "instruction_idx", "success", "controlled_by"],
      "properties": {
        "start_time": {
          "type": "number",
          "minimum": 0,
          "description": "UNIX timestamp (seconds since epoch) when this segment began."
        },
        "end_time": {
          "type": "number",
          "minimum": 0,
          "description": "UNIX timestamp (seconds since epoch) when this segment ended."
        },
        "instruction_idx": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the corresponding instruction."
        },
        "score": {
          "type": "number",
          "description": "Score of the segment. Non-mandatory, should be treated as 1.0 if missing."
        },
        "success": {
          "type": "boolean",
          "description": "Whether this segment completed successfully."
        },
        "controlled_by": {
          "type": "string",
          "description": "Component/entity controlling execution (e.g. 'operator', 'auto_data_collection')."
        },
        "is_composite": {
          "type": "boolean",
          "description": "Optional flag indicating a composite (hierarchical) segment."
        }
      },
      "additionalProperties": false
    }
  }
}
